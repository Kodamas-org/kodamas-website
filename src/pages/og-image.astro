---
// The share image (Open Graph), 1200 × 630: the drop cluster before the
// giant wordmark, with a few wisps, on the navy canvas with grain. Not a
// page for visitors: `npm run og-image` photographs it into
// public/og-image.png, which BaseLayout links as og:image.
// The wisp field positions below are the image's fixed composition.
import '@fontsource-variable/funnel-display';
import '../styles/tokens.css';
import '../styles/global.css';
import Grain from '../components/atoms/Grain.astro';
import Wordmark from '../components/atoms/Wordmark.astro';
import DropCluster from '../components/molecules/DropCluster.astro';
import WispField from '../components/molecules/WispField.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>Share image · Kodamas</title>
	</head>
	<body>
		<Grain />
		<div class="og">
			<div class="og__wisps og__wisps--top"><WispField /></div>
			<div class="og__wisps og__wisps--bottom"><WispField size="pair" /></div>
			<div class="og__symbol"><DropCluster /></div>
			<div class="og__mark">
				<span class="visually-hidden">Kodamas</span>
				<Wordmark variant="giant" />
			</div>
		</div>
	</body>
</html>

<style>
	.og {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-8);
		width: var(--size-og-width);
		height: var(--size-og-height);
		padding-inline: var(--space-10);
		overflow: hidden;
		background: var(--color-surface-page);
		--size-drop-cluster: calc(var(--size-og-height) * 0.36);
		--size-wisp: calc(var(--size-og-height) * 0.07);
	}
	.og__symbol {
		flex: none;
	}
	.og__mark {
		flex: 1;
		min-width: 0;
	}
	.og__wisps {
		position: absolute;
	}
	.og__wisps--top {
		top: var(--space-7);
		right: var(--space-10);
		width: 42%;
		height: 30%;
	}
	.og__wisps--bottom {
		bottom: var(--space-6);
		left: 34%;
		width: 26%;
		height: 24%;
	}
</style>
