---
// Thank you: where the Tally contact form (Connect With Us) sends people
// after they send a message. Not linked from the site and not indexed.
// Copy: the form's thank-you message. The footer leads back to the site.
// The drop cluster sits in the space beside the title, wisps drifting by,
// both on the page grid.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/organisms/PageIntro.astro';
import Container from '../components/atoms/Container.astro';
import DropCluster from '../components/molecules/DropCluster.astro';
import WispField from '../components/molecules/WispField.astro';
---

<BaseLayout
	title="Thank you · Kodamas"
	description="Your message is on its way to Emma and Daniela. We'll be in touch soon."
	noindex
>
	<div class="thanks">
		<div class="thanks__layer">
			<Container>
				<div class="thanks__decor">
					<div class="thanks__wisps"><WispField size="pair" /></div>
					<div class="thanks__symbol"><DropCluster /></div>
				</div>
			</Container>
		</div>
		<PageIntro>
			<Fragment slot="title">Thank <em>you!</em></Fragment>
			Your message is on its way to Emma and Daniela. We'll be in touch soon.
		</PageIntro>
	</div>
</BaseLayout>

<style>
	.thanks {
		position: relative;
		padding-bottom: var(--layout-section);
		--size-drop-cluster: var(--size-drop-cluster-s);
	}
	.thanks__layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.thanks__decor {
		position: relative;
	}
	.thanks__symbol {
		position: absolute;
		top: var(--space-7);
		right: 0;
	}
	.thanks__wisps {
		position: absolute;
		top: var(--space-5);
		right: calc(var(--size-drop-cluster) + var(--space-5));
		width: 30%;
		height: var(--space-10);
	}
	@media (max-width: 48rem) {
		.thanks__symbol {
			top: var(--space-6);
		}
		.thanks__wisps {
			--size-wisp: var(--size-wisp-s);
			width: 35%;
		}
	}
</style>
