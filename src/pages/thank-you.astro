---
// Thank you: where the Tally contact form (Connect With Us) sends people
// after they send a message. Not linked from the site and not indexed.
// Copy: the form's thank-you message. The footer leads back to the site.
// Title and message centred, one above the other; a small drop cluster
// just behind the T, wisps drifting at the bottom right.
// The offsets of the cluster are its fixed placement against the letter.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/atoms/Container.astro';
import Heading from '../components/atoms/Heading.astro';
import DropCluster from '../components/molecules/DropCluster.astro';
import WispField from '../components/molecules/WispField.astro';
---

<BaseLayout
	title="Thank you · Kodamas"
	description="Your message is on its way to Emma and Daniela. We'll be in touch soon."
	noindex
>
	<div class="thanks">
		<Container>
			<div class="thanks__block">
				<div class="thanks__title">
					<span class="thanks__symbol"><DropCluster /></span>
					<Heading level={1} size="statement">Thank <em>you!</em></Heading>
				</div>
				<p class="thanks__lead">
					<span class="thanks__line">Your message is on its way to <span class="thanks__keep">Emma and Daniela.</span></span>
					<span class="thanks__line">We'll be in touch soon.</span>
				</p>
				<div class="thanks__wisps"><WispField size="pair" /></div>
			</div>
		</Container>
	</div>
</BaseLayout>

<style>
	.thanks {
		/* Top a little more than the bottom: the footer adds its own space */
		padding-block: calc(var(--space-10) + var(--space-5)) var(--space-10);
		--size-drop-cluster: var(--size-drop-cluster-s);
	}
	.thanks__block {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	/* The cluster sits behind the title, its centre near the top of the T */
	.thanks__title {
		position: relative;
		isolation: isolate;
	}
	.thanks__title :global(.heading) {
		font-size: var(--font-size-statement-xl);
	}
	.thanks__symbol {
		position: absolute;
		z-index: -1;
		left: calc(var(--size-drop-cluster) * -0.45);
		top: calc(var(--size-drop-cluster) * -0.5);
	}

	.thanks__lead {
		max-width: var(--layout-text-max);
		margin-top: var(--space-6);
		font-size: var(--font-size-lead);
		line-height: var(--line-height-lead);
		text-wrap: pretty;
	}
	/* Each sentence on its own line; if one must wrap, the names stay together */
	.thanks__line {
		display: block;
	}
	.thanks__keep {
		white-space: nowrap;
	}

	.thanks__wisps {
		position: absolute;
		right: 0;
		bottom: calc(var(--space-9) * -1);
		width: 30%;
		height: var(--space-10);
	}

	/* Title, message and wisps rise in one beat apart */
	.thanks__title,
	.thanks__lead,
	.thanks__wisps {
		animation: rise var(--duration-rise) var(--ease-standard) both;
	}
	.thanks__lead {
		animation-delay: calc(var(--duration-beat) / 2);
	}
	.thanks__wisps {
		animation-delay: var(--duration-beat);
	}

	@media (max-width: 48rem) {
		.thanks__wisps {
			--size-wisp: var(--size-wisp-s);
			width: 50%;
			height: var(--space-9);
			bottom: calc(var(--space-10) * -1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.thanks__title,
		.thanks__lead,
		.thanks__wisps {
			animation: none;
		}
	}
</style>
