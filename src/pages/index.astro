---
// Homepage. Design direction: one navy canvas with a single bright moment
// (the aqua offer), Funnel Display Light against Bold, editorial section
// numbers, the drop as the visual system, and motion that carries meaning.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/organisms/Hero.astro';
import OfferSection from '../components/organisms/OfferSection.astro';
import ProofSection from '../components/organisms/ProofSection.astro';
import TestimonialsSection from '../components/organisms/TestimonialsSection.astro';
import TeamSection from '../components/organisms/TeamSection.astro';
import ClosingSection from '../components/organisms/ClosingSection.astro';
import Testimonial from '../components/molecules/Testimonial.astro';
import PersonCard from '../components/molecules/PersonCard.astro';
import Button from '../components/atoms/Button.astro';
import Link from '../components/atoms/Link.astro';
import Highlight from '../components/atoms/Highlight.astro';
import Clock from '../components/atoms/Clock.astro';
import { links } from '../data/links';
import { photos } from '../data/photos';
---

<BaseLayout
	title="Kodamas"
	description="When your app and team outgrow their DIY phase, we build the tools and processes that keep your people happy and product & growth moving together."
>
	<Hero>
		When your app and team <Highlight variant="underline">outgrow their DIY phase</Highlight>, we build the tools and
		processes that keep your people happy and product &amp; growth moving together.
		<Fragment slot="actions">
			<Button href={links.bookCall}>Book a call</Button>
			<Link href="#offer" variant="action" arrow="↓">The Offer</Link>
		</Fragment>
	</Hero>

	<OfferSection
		num="01"
		label="The Offer"
		title="The Founder Reset Sprint 🚀"
		price={{ amount: '€500', duration: '1 week', note: 'Limited-offer launch pricing' }}
		cta={{ label: 'Book a call', href: links.bookCall }}
		items={[
			{ title: 'Product UI/UX and operations audit', text: "Find what's quietly killing your conversion and team sanity." },
			{ title: 'Marketing & Sales audit', text: 'Find where your revenue is leaking, KPI by KPI.' },
			{ title: 'Combined 90-day roadmap', text: 'Both audits compared with initiatives ranked by impact' },
		]}
		coveredLabel="What’s Covered"
		covered={['Pipeline & CRM', 'Funnel', 'Product Design', 'Product Delivery', 'Operations']}
	>
		<Fragment slot="statement">
			Most consultants give you one half of this. <strong>We give you both, prioritized and sequenced.</strong>
		</Fragment>
	</OfferSection>

	<ProofSection
		num="02"
		stats={[
			{ value: 400, suffix: '%', caption: 'ROI', icon: 'trend', accent: true },
			{ value: 6, prefix: '<', caption: 'payback in under six months', icon: 'timer' },
			{ value: 7.2, decimals: 1, suffix: '%', caption: 'lift in conversion rate', icon: 'bars' },
		]}
		source="(Forrester Consulting)"
		wisps
	>
		<Fragment slot="title">Why is streamlining processes <em>early</em> on a good idea?</Fragment>
		"Fixing usability issues before launch has been shown to deliver over 400% ROI with payback in under six months,
		driven largely by a 7.2% lift in conversion rate."
	</ProofSection>

	<TestimonialsSection num="03" title="What people say about us" count={3}>
		<Testimonial index={1} name="Geoff Hucker" href={links.geoffHucker} photo={photos.geoffHucker} role="Work for Impact CEO & Founder">
			“Daniela <em>sets clear priorities</em> and drives cross-functional teams to deliver on time and to a high standard.”
		</Testimonial>
		<Testimonial
			index={2}
			long
			name="Samyukta Kartik"
			href={links.samyuktaKartik}
			photo={photos.samyuktaKartik}
			role="Marketing & Communications Consultant"
		>
			“Emma created <em>a thriving environment</em> where every team member had the space to grow into their unique
			strengths. Her insights helped me and contributed to some of our best team achievements.”
		</Testimonial>
		<Testimonial index={3} long name="Martin Kubler" href={links.martinKubler} photo={photos.martinKubler} role="Founder of The Gluttonous Sloth">
			“Emma has managed to create <em>a great team culture</em> with the right balance of goal-hungriness and market
			realism. Furthermore, creating a great product with limited resources takes great skill, yet somehow Daniela
			manages this effortlessly.”
		</Testimonial>
	</TestimonialsSection>

	<TeamSection num="04" title="Our team">
		<Fragment slot="lead">
			Based in <span class="nowrap">Italy<Clock zone="Europe/Rome" /></span> and <span class="nowrap"
				>Japan<Clock zone="Asia/Tokyo" />,</span
			> working globally 🌏.
		</Fragment>
		<PersonCard
			name="Daniela Contessa"
			role="Former Head of Product"
			org={{ label: '@HappyCow', href: links.happyCowDaniela }}
			nationality="Italian"
			flag="🇮🇹"
			photo={photos.daniela}
		/>
		<PersonCard
			name="Emma Cebuliak"
			role="Former Head of Business Growth"
			org={{ label: '@HappyCow', href: links.happyCowEmma }}
			nationality="Canadian"
			flag="🇨🇦"
			photo={photos.emma}
		/>
	</TeamSection>

	<ClosingSection
		num="05"
		title="Keep Going"
		words={{ outline: 'Keep', fill: 'Going' }}
		cta={{ label: 'Connect With Us', href: links.connect }}
	>
		<p>The Sprint gives you the roadmap.</p>
		<p>
			If you want help executing it, work with us ongoing on either lateral, product or marketing/sales, or both.
		</p>
	</ClosingSection>
</BaseLayout>
