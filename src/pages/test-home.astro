			<div class="c-team__grid">
				{
					team.map((p) => (
						<article class="c-person" data-reveal>
							<div class="c-person__frame">
								<div class="c-ph c-ph--drop c-person__photo" role="img" aria-label={`${p.name} (photo needed)`}>
