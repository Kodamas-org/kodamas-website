---
// TEST HOME — art-direction concept, round 2.
// Keeps only the brand fonts, the colour palette and the existing copy.
//
// Direction: one dark canvas (navy) with a single bright moment (the aqua
// offer). Refinement comes from typography (Funnel Display Light against
// Bold), editorial details (section numbers, hairlines), a subtle grain,
// and motion that carries meaning: counters for the proof, focus on the
// quote being read, kinetic type for "Keep Going", live clocks for Italy
// and Japan. All motion respects reduced-motion settings.
//
// Layout values are page-scoped (--c-*) on top of the global tokens.
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../data/links';

const items = [
	{
		title: 'Product UI/UX and operations audit',
		text: "Find what's quietly killing your conversion and team sanity.",
	},
	{ title: 'Marketing & Sales audit', text: 'Find where your revenue is leaking, KPI by KPI.' },
	{ title: 'Combined 90-day roadmap', text: 'Both audits compared with initiatives ranked by impact' },
];
const covered = ['Pipeline & CRM', 'Funnel', 'Product Design', 'Product Delivery', 'Operations'];

// Quotes split around the phrase that gets highlighted (wording unchanged)
const voices = [
	{
		before: '“Daniela ',
		key: 'sets clear priorities',
		after: ' and drives cross-functional teams to deliver on time and to a high standard.”',
		name: 'Geoff Hucker',
		href: links.geoffHucker,
		role: 'Work for Impact CEO & Founder',
		long: false,
	},
	{
		before: '“Emma created ',
		key: 'a thriving environment',
		after: ' where every team member had the space to grow into their unique strengths. Her insights helped me and contributed to some of our best team achievements.”',
		name: 'Samyukta Kartik',
		href: links.samyuktaKartik,
		role: 'Marketing & Communications Consultant',
		long: true,
	},
	{
		before: '“Emma has managed to create ',
		key: 'a great team culture',
		after: ' with the right balance of goal-hungriness and market realism. Furthermore, creating a great product with limited resources takes great skill, yet somehow Daniela manages this effortlessly.”',
		name: 'Martin Kubler',
		href: links.martinKubler,
		role: 'Founder of The Gluttonous Sloth',
		long: true,
	},
];
const team = [
	{ name: 'Daniela Contessa', role: 'Former Head of Product', org: links.happyCowDaniela, nationality: 'Italian', flag: '🇮🇹' },
	{ name: 'Emma Cebuliak', role: 'Former Head of Business Growth', org: links.happyCowEmma, nationality: 'Canadian', flag: '🇨🇦' },
];
const footerLinks = [
	{ label: 'Our Story', href: links.ourStory },
	{ label: 'Blogfolio', href: links.blogfolio },
	{ label: 'Emma’s LinkedIn', href: links.emmaLinkedIn },
	{ label: 'Daniela’s LinkedIn', href: links.danielaLinkedIn },
];
const letters = ['K', 'o', 'd', 'a', 'm', 'a', 's'];
const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((w) => w[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<BaseLayout
	title="Test Home · Kodamas"
	description="When your app and team outgrow their DIY phase, we build the tools and processes that keep your people happy and product & growth moving together."
	noindex
>
	<div class="c">
		<div class="c-grain" aria-hidden="true"></div>

		<!-- HERO -->
