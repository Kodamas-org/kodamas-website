								x="7"
								y="1"
								width="3"
								height="10"
								rx="1"
								fill="currentColor"></rect></svg
						>
						<svg class="c-pause__icon c-pause__icon--play" viewBox="0 0 12 12" aria-hidden="true"
							><path d="M3 1.5v9l7.5-4.5z" fill="currentColor"></path></svg
