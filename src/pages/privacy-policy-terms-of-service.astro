---
// Privacy Policy & Terms of Service, on the same template as the articles
// (ArticleLayout), without author block or call to action. The text lives
// in src/legal/privacy-terms.md; update the date below whenever it changes.
// Same address as on the previous site, so existing links keep working.
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { Content, getHeadings } from '../legal/privacy-terms.md';

const updated = '14 October 2026';
---

<ArticleLayout
	title="Privacy Policy & Terms of Service"
	description="Kodamas uses no cookies, no analytics and no forms. What happens to your data when you visit or email us, and the terms for using the site."
	summary="In short: this website uses no cookies, no analytics and no forms. Here is what happens to your data when you visit or email us, and the terms for using the site."
	meta={`Last updated: ${updated}`}
	headings={getHeadings()}
	tocLabel="On this page"
>
	<Content />
</ArticleLayout>
