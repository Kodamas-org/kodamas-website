---
// Blogfolio. Built from the shared system, in the homepage's design
// direction. Copy from reference/kodamas-blog-page.png, word for word.
// The list comes from the articles in src/content/blog/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/organisms/PageIntro.astro';
import CallToActionSection from '../../components/organisms/CallToActionSection.astro';
import Section from '../../components/molecules/Section.astro';
import CaseStudy from '../../components/molecules/CaseStudy.astro';
import WispField from '../../components/molecules/WispField.astro';
import { getCollection } from 'astro:content';
import { links } from '../../data/links';

// Every final article, in Blogfolio order (order first, then newest first)
const posts = (await getCollection('blog', ({ data }) => data.status === 'final')).sort(
	(a, b) =>
		(a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
		(b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<BaseLayout
	title="Blogfolio · Kodamas"
	description="Before Kodamas, we helped build, fix, and grow digital products around the world. Here, we share what we learned and what we are learning."
>
	<div class="intro">
		<div class="intro__wisps"><WispField /></div>
		<PageIntro label="Welcome to our Blogfolio">
		<Fragment slot="title">Notes from the <em>Doing</em></Fragment>
		Before Kodamas, we helped build, fix, and grow digital products around the world. Here, we share what we learned and
		what we are learning.
		</PageIntro>
	</div>

	<Section num="01">
		<ol class="cases" role="list">
			{
				posts.map(({ id, data }, i) => (
					<li>
						<CaseStudy
							label={data.label}
							title={data.cardTitle ?? data.title}
							href={`${links.blogfolio}/${id}`}
							photo={data.photo}
							alt={data.photoAlt}
							reverse={i % 2 === 1}
						>
							{data.summary}
						</CaseStudy>
					</li>
				))
			}
		</ol>
	</Section>

	<div class="cta-gap">
		<CallToActionSection
			num="02"
			title="Want your delivery management to be aligned and effortless?"
			cta={{ label: 'Connect With Us', href: links.connect }}
		>
			<p>At <strong>Kodamas</strong>, we help teams move faster, collaborate better, and sale with ease.</p>
			<p>If your internal delivery ops feel like chaos, let’s turn them into clarity.</p>
		</CallToActionSection>
	</div>
</BaseLayout>

<style>
	/* Trial: kodama wisps in the empty space beside the title */
	.intro {
		position: relative;
	}
	.intro__wisps {
		position: absolute;
		top: var(--space-6);
		right: var(--layout-gutter);
		width: 40%;
		height: var(--space-10);
	}
	/* Mobile: the title spans the width, so the wisps sit in the gap below the intro */
	@media (max-width: 48rem) {
		.intro__wisps {
			top: 100%;
			width: 70%;
			height: var(--layout-section);
		}
	}
	.cases {
		display: flex;
		flex-direction: column;
		gap: var(--layout-section);
	}
	/* The bright section follows a navy one: keep the one section gap above it */
	.cta-gap {
		margin-top: var(--layout-section);
	}
</style>
