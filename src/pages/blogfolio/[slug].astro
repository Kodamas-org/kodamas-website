---
// One page per Blogfolio article (case study or blog post): each Markdown
// file in src/content/blog/ becomes /blogfolio/<file name>. The layout lives
// in ArticleLayout, shared by every article; this file only reads the
// article's data and passes it on.
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAuthor } from '../../data/authors';
import { ctas } from '../../data/ctas';
import { pages } from '../../data/navigation';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => data.status === 'final');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

// The closing call to action: a key from src/data/ctas.ts or the article's own
const cta = typeof data.cta === 'string' ? ctas[data.cta] : (data.cta ?? ctas.delivery);
const date = data.date?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const author = getAuthor(data.author);
---

<ArticleLayout
	title={data.seoTitle ?? data.title}
	heading={data.title}
	description={data.description}
	label={data.label}
	back={pages.blogfolio}
	summary={data.summary}
	meta={[author.name, date].filter(Boolean).join(' · ')}
	headings={headings}
	author={author}
	cta={cta}
>
	<Content />
</ArticleLayout>
