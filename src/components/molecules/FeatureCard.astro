---
// Outlined card with a title and a short description. Used for the items
// inside the offer. `wide` makes it span every column of its grid.
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

interface Props {
	title: string;
	level?: 3 | 4;
	wide?: boolean;
}

const { title, level = 3, wide = false } = Astro.props;
---

<div class:list={['feature-card', { 'feature-card--wide': wide }]}>
	<Heading level={level} size="heading-3">{title}</Heading>
	<Text><slot /></Text>
</div>

<style>
	.feature-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-5);
		border: var(--border-width-medium) solid var(--color-white);
		border-radius: var(--radius-s);
	}
	.feature-card--wide {
		grid-column: 1 / -1;
	}
</style>
