---
// Long-form text rendered from Markdown (blog articles). Styles the plain
// elements Markdown produces: each h2 opens a numbered part (small pink
// 01, 02… on a hairline), bold turns aqua, list bullets are small drops,
// a blockquote is a large pull statement, images get soft corners.
// Slot default: the rendered Markdown
---

<div class="prose"><slot /></div>

<style>
	.prose {
		counter-reset: prose-part;
		font-size: var(--font-size-lead);
		line-height: var(--line-height-lead);
	}
	.prose :global(* + *) {
		margin-top: var(--space-5);
	}

	/* ---------- Parts: h2 with its number on a hairline ---------- */
	.prose :global(h2) {
		counter-increment: prose-part;
		margin-top: var(--space-10);
		padding-top: var(--space-4);
		border-top: var(--border-width-thin) solid var(--color-rule);
		font-family: var(--font-display);
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-display);
		text-wrap: balance;
		/* Jumping here from the contents leaves room above the heading */
		scroll-margin-top: var(--space-8);
	}
	.prose :global(h2)::before {
		content: counter(prose-part, decimal-leading-zero);
		display: block;
		margin-bottom: var(--space-5);
		font-family: var(--font-body);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-label);
		color: var(--color-number);
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(h3) {
		margin-top: var(--space-8);
		font-family: var(--font-display);
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
	}
	.prose :global(h2 + *),
	.prose :global(h3 + *) {
		margin-top: var(--space-5);
	}

	/* ---------- Inline ---------- */
	.prose :global(strong) {
		font-weight: var(--font-weight-bold);
		color: var(--color-accent);
	}
	.prose :global(a) {
		color: var(--color-accent);
		text-decoration-thickness: var(--border-width-thin);
		text-underline-offset: var(--size-underline-offset);
	}
	.prose :global(a:hover) {
		text-decoration-thickness: var(--border-width-medium);
	}

	/* ---------- Lists: bullets are small drops ---------- */
	.prose :global(ul),
	.prose :global(ol) {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}
	.prose :global(li) {
		position: relative;
		margin-top: 0;
		padding-left: var(--space-6);
	}
	.prose :global(ul > li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: var(--space-3);
		width: var(--size-icon-s);
		aspect-ratio: 1;
		border-radius: var(--radius-drop);
		background: var(--gradient-drop);
	}
	.prose :global(ol) {
		counter-reset: prose-item;
	}
	.prose :global(ol > li) {
		counter-increment: prose-item;
	}
	.prose :global(ol > li)::before {
		content: counter(prose-item);
		position: absolute;
		left: 0;
		font-weight: var(--font-weight-semibold);
		color: var(--color-number);
	}
	.prose :global(li ul),
	.prose :global(li ol) {
		margin-top: var(--space-3);
	}

	/* ---------- Pull statement ---------- */
	.prose :global(blockquote) {
		margin-block: var(--space-8);
		font-family: var(--font-display);
		font-size: var(--font-size-quote);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-display);
		color: var(--color-accent);
		text-wrap: balance;
	}

	/* ---------- Media and rules ---------- */
	.prose :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-s);
	}
	.prose :global(hr) {
		border: 0;
		border-top: var(--border-width-thin) solid var(--color-rule);
	}
	.prose :global(code) {
		font-size: var(--font-size-small);
	}
</style>
