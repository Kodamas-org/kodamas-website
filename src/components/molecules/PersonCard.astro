---
// A team member, centred: drop-shaped portrait (it turns round on hover) with
// a flag badge, then name, role with a linked organisation, and nationality.
import Avatar from '../atoms/Avatar.astro';

interface Props {
	name: string;
	role: string;
	org: { label: string; href: string };
	nationality: string;
	flag: string;
	photo?: string;
}

const { name, role, org, nationality, flag, photo } = Astro.props;
---

<article class="person-card" data-reveal>
	<div class="person-card__frame">
		<Avatar name={name} src={photo} shape="drop" size="l" />
		<span class="person-card__flag" aria-hidden="true">{flag}</span>
	</div>
	<h3 class="person-card__name">{name}</h3>
	<p>{role}{' '}<a href={org.href}>{org.label}</a></p>
	<p class="person-card__nat">{nationality}</p>
</article>

<style>
	.person-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		text-align: center;
	}
	.person-card__frame {
		position: relative;
		width: 100%;
		max-width: var(--layout-team-column);
		margin-bottom: var(--space-5);
	}
	.person-card:hover .person-card__frame > :global(.avatar) {
		border-radius: var(--radius-round);
	}
	.person-card__flag {
		position: absolute;
		left: 0;
		bottom: 0;
		display: grid;
		place-items: center;
		width: var(--size-tap-min);
		aspect-ratio: 1;
		background: var(--color-midnight-navy);
		border-radius: var(--radius-round);
		font-size: var(--font-size-lead);
	}
	.person-card__name {
		font-family: var(--font-display);
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-snug);
	}
	.person-card a {
		color: var(--color-accent);
		text-underline-offset: var(--size-underline-offset);
	}
	.person-card__nat {
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	@media (max-width: 48rem) {
		.person-card__frame {
			max-width: calc(var(--size-avatar-l) * 1.25);
		}
	}
</style>
