---
// Client quote in a pink card, with a round photo overlapping the left edge,
// the author's name as a link and their role.
// quoteSize: 'l' for short quotes, 's' for long ones.
import Avatar from '../atoms/Avatar.astro';
import Link from '../atoms/Link.astro';

interface Props {
	name: string;
	href: string;
	role: string;
	photo?: string;
	quoteSize?: 'l' | 's';
}

const { name, href, role, photo, quoteSize = 'l' } = Astro.props;
---

<figure class="testimonial">
	<Avatar src={photo} alt={name} shape="circle" size="testimonial" class="testimonial__photo" />
	<div class="testimonial__card">
		<blockquote class:list={['testimonial__quote', `testimonial__quote--${quoteSize}`]}>
			<p><slot /></p>
		</blockquote>
		<figcaption class="testimonial__author">
			<Link href={href} tone="white">{name}</Link>
			<span class="testimonial__role">{role}</span>
		</figcaption>
	</div>
</figure>

<style>
	.testimonial {
		position: relative;
		display: grid;
		grid-template-columns: var(--size-avatar-testimonial) 1fr;
		align-items: center;
	}
	.testimonial :global(.testimonial__photo) {
		grid-column: 1;
		grid-row: 1;
		position: relative;
		z-index: var(--z-raised);
	}
	.testimonial__card {
		grid-column: 1 / -1;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		margin-left: var(--overlap-testimonial-card);
		padding: var(--space-7) var(--space-10) var(--space-7) var(--indent-testimonial-text);
		background: var(--color-surface-pink);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-card);
		color: var(--color-white);
		--focus-color: var(--color-focus-on-light);
	}
	.testimonial__quote {
		font-family: var(--font-display);
		font-weight: var(--font-weight-bold);
		font-style: italic;
	}
	.testimonial__quote--l {
		font-size: var(--font-size-heading-2);
		line-height: var(--line-height-snug);
	}
	.testimonial__quote--s {
		font-size: var(--font-size-quote-s);
		line-height: var(--line-height-heading);
	}
	.testimonial__author {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		font-size: var(--font-size-body-m);
	}

	@media (max-width: 48rem) {
		.testimonial {
			grid-template-columns: 1fr;
			justify-items: start;
		}
		.testimonial :global(.testimonial__photo) {
			margin-left: var(--space-5);
		}
		.testimonial__card {
			grid-row: 2;
			margin-left: 0;
			margin-top: calc(var(--size-avatar-testimonial) / -2);
			padding: calc(var(--size-avatar-testimonial) / 2 + var(--space-5)) var(--space-5) var(--space-6);
			gap: var(--space-5);
		}
	}
</style>
