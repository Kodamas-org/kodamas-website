---
// A client quote set large in Funnel Display Light, with the key phrase in
// aqua bold (wrap it in <em> in the slot), then a byline: round photo, name
// (linked) and role.
// long: a smaller size for longer quotes
// index: position in a TestimonialsSection (used for its focus effect)
import Avatar from '../atoms/Avatar.astro';

interface Props {
	name: string;
	href: string;
	role: string;
	photo?: string;
	long?: boolean;
	index?: number;
}

const { name, href, role, photo, long = false, index } = Astro.props;
---

<figure class:list={['testimonial', { 'testimonial--long': long }]} data-voice={index}>
	<blockquote>
		<p><slot /></p>
	</blockquote>
	<figcaption class="testimonial__byline">
		<Avatar name={name} src={photo} shape="round" size="s" />
		<span>
			<a href={href}>{name}</a>
			<span>{role}</span>
		</span>
	</figcaption>
</figure>

<style>
	.testimonial {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		transition: opacity var(--duration-reveal) var(--ease-standard);
	}
	.testimonial blockquote {
		font-family: var(--font-display);
		font-size: var(--font-size-quote);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-display);
	}
	.testimonial--long blockquote {
		font-size: var(--font-size-quote-long);
	}
	.testimonial :global(em) {
		font-style: normal;
		font-weight: var(--font-weight-bold);
		color: var(--color-accent);
	}
	.testimonial__byline {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-size: var(--font-size-small);
		line-height: var(--line-height-lead);
		color: var(--color-text-muted);
	}
	.testimonial__byline > span {
		display: flex;
		flex-direction: column;
	}
	.testimonial__byline a {
		font-size: var(--font-size-ui);
		font-weight: var(--font-weight-semibold);
		color: var(--color-text-on-dark);
		text-underline-offset: var(--size-underline-offset);
	}
</style>
