---
// Client quote card: a white drop as the quote mark, the quote, then a row
// with a small round photo, the author's name (linked) and their role.
// Cards stretch to equal height inside a grid.
import Avatar from '../atoms/Avatar.astro';
import Drop from '../atoms/Drop.astro';
import Link from '../atoms/Link.astro';

interface Props {
	name: string;
	href: string;
	role: string;
	photo?: string;
}

const { name, href, role, photo } = Astro.props;
---

<figure class="testimonial">
	<Drop size="s" tone="white" />
	<blockquote class="testimonial__quote">
		<p><slot /></p>
	</blockquote>
	<figcaption class="testimonial__author">
		<Avatar src={photo} alt={name} shape="circle" size="testimonial" />
		<span class="testimonial__meta">
			<Link href={href} tone="white" class="testimonial__name">{name}</Link>
			<span class="testimonial__role">{role}</span>
		</span>
	</figcaption>
</figure>

<style>
	.testimonial {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		height: 100%;
		padding: var(--space-card);
		background: var(--color-surface-pink);
		border-radius: var(--radius-m);
		box-shadow: var(--shadow-card);
		color: var(--color-white);
		--focus-color: var(--color-focus-on-light);
	}
	.testimonial__quote {
		flex-grow: 1;
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
	}
	.testimonial__author {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.testimonial__meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		line-height: var(--line-height-ui);
	}
	.testimonial :global(.testimonial__name) {
		font-size: var(--font-size-ui);
		font-weight: var(--font-weight-semibold);
	}
	.testimonial__role {
		font-size: var(--font-size-small);
	}
</style>
