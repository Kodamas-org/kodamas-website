---
// The author block under an article, on a hairline: the author's photo in a
// drop (or the floating Kodamas symbol when the author is Kodamas), then
// "Written by", the name, the role, a short bio and a link.
// author: from src/data/authors.ts (getAuthor)
import type { Author } from '../../data/authors';
import Avatar from '../atoms/Avatar.astro';
import Link from '../atoms/Link.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import DropCluster from './DropCluster.astro';

interface Props {
	author: Author;
	label?: string;
}

const { author, label = 'Written by' } = Astro.props;
---

<aside class="author-card" aria-label={`${label} ${author.name}`}>
	<div class="author-card__avatar">
		{author.photo ? <Avatar name={author.name} src={author.photo} shape="drop" size="m" /> : <DropCluster />}
	</div>
	<div class="author-card__body">
		<Eyebrow tone="pink">{label}</Eyebrow>
		<p class="author-card__name">{author.name}</p>
		<p class="author-card__role">{author.role}</p>
		<p class="author-card__bio">{author.bio}</p>
		<Link href={author.link.href} variant="action" arrow="→">{author.link.label}</Link>
	</div>
</aside>

<style>
	.author-card {
		display: flex;
		align-items: flex-start;
		gap: var(--space-6);
		padding-top: var(--space-6);
		border-top: var(--border-width-thin) solid var(--color-rule);
	}
	.author-card__avatar {
		flex-shrink: 0;
		/* The Kodamas symbol at avatar size */
		--size-drop-cluster: var(--size-avatar-m);
	}
	.author-card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}
	.author-card__name {
		font-family: var(--font-display);
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-display);
	}
	.author-card__role {
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
		color: var(--color-accent);
	}
	.author-card__bio {
		margin-top: var(--space-2);
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
	}
	@media (max-width: 48rem) {
		.author-card {
			flex-direction: column;
			gap: var(--space-5);
		}
	}
</style>
