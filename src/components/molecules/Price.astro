---
// A price between two hairlines: the amount large, with two short lines of
// detail beside it (duration in bold, a note in italic).
interface Props {
	amount: string;
	duration: string;
	note?: string;
}

const { amount, duration, note } = Astro.props;
---

<p class="price">
	<span class="price__amount">{amount}</span>
	<span class="price__meta">
		<strong>{duration}</strong>
		{note && <em>{note}</em>}
	</span>
</p>

<style>
	.price {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		width: 100%;
		padding-block: var(--space-5);
		border-block: var(--border-width-thin) solid var(--color-rule);
	}
	.price__amount {
		font-family: var(--font-display);
		font-size: var(--font-size-heading-2);
		font-weight: var(--font-weight-heavy);
		line-height: var(--line-height-none);
		letter-spacing: var(--letter-spacing-display);
	}
	.price__meta {
		display: flex;
		flex-direction: column;
		font-size: var(--font-size-small);
		line-height: var(--line-height-lead);
	}
</style>
