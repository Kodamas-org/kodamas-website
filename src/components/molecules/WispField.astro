---
// Kodama wisps: small spirit lights from the forest, round orbs with a
// white core glowing in the brand aqua and a soft aqua halo, flickering and drifting slowly upwards, with a few
// twinkling sparks around them. Decorative. Fills its container (the parent
// positions and sizes it).
// They fade in slowly, one after another, when the page loads or when
// scrolled into view; as the
// page scrolls on they rise faster than the page and fade away. Their motion
// pauses off screen and stops entirely for reduced motion.
// size: 'group' (three wisps) or 'pair' (two)
// The positions and scales below are the field's fixed geometry.
interface Props {
	size?: 'group' | 'pair';
}

const { size = 'group' } = Astro.props;

const geometry = {
	group: {
		wisps: [
			{ x: '62%', y: '8%', s: 0.6 },
			{ x: '78%', y: '52%', s: 1.3 },
			{ x: '36%', y: '64%', s: 0.75 },
		],
		sparks: [
			{ x: '8%', y: '58%' },
			{ x: '30%', y: '12%' },
			{ x: '50%', y: '40%' },
			{ x: '70%', y: '30%' },
			{ x: '92%', y: '20%' },
			{ x: '58%', y: '86%' },
			{ x: '86%', y: '88%' },
		],
	},
	pair: {
		wisps: [
			{ x: '20%', y: '30%', s: 1 },
			{ x: '64%', y: '6%', s: 0.65 },
		],
		sparks: [
			{ x: '6%', y: '20%' },
			{ x: '48%', y: '70%' },
			{ x: '88%', y: '40%' },
		],
	},
};
const { wisps, sparks } = geometry[size];
---

<script is:inline>
	// Set during parsing, before the first paint, so the wisps start hidden
	// and fade in instead of flashing (nothing for reduced motion or no JS)
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window)
		document.documentElement.classList.add('js-wisps');
</script>

<div class="wisp-field" aria-hidden="true" data-wisp-field>
	<div class="wisp-field__inner">
		{
			wisps.map((w, i) => (
				<span class="wisp" style={`--x: ${w.x}; --y: ${w.y}; --s: ${w.s}; --i: ${i}`}>
					<span class="wisp__halo" />
					<span class="wisp__flame" />
				</span>
			))
		}
		<span class="wisp-field__sparks" style={`--i: ${wisps.length}`}>
			{sparks.map((p, i) => <span class="wisp-field__spark" style={`--x: ${p.x}; --y: ${p.y}; --i: ${i}`} />)}
		</span>
	</div>
</div>

<script>
	// Fade in when scrolled into view, pause off screen, and rise away while
	// the page scrolls on. Nothing runs for reduced motion: the wisps stay
	// visible and still.
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const fields = [...document.querySelectorAll<HTMLElement>('[data-wisp-field]')];
	if (!calm && fields.length && 'IntersectionObserver' in window) {
		// How far (fraction of the viewport) the field travels with the page
		// before it starts to rise away, and over what distance it fades out.
		const HOLD = 0.4;
		const FADE = 0.5;
		const RISE = 0.6; // extra upward speed relative to the page

		const io = new IntersectionObserver((entries) =>
			entries.forEach((e) => {
				const field = e.target as HTMLElement;
				field.toggleAttribute('data-visible', e.isIntersecting);
				if (e.isIntersecting) field.setAttribute('data-lit', '');
			}),
		);

		const starts = new Map<HTMLElement, number>();
		const measure = () => {
			const vh = window.innerHeight;
			fields.forEach((f) => {
				const top = f.getBoundingClientRect().top + window.scrollY;
				// Fields near the top of the page start rising on the first scroll
				starts.set(f, Math.max(0, top - vh * (1 - HOLD)));
			});
		};
		let ticking = false;
		const update = () => {
			ticking = false;
			const vh = window.innerHeight;
			fields.forEach((f) => {
				const past = Math.max(0, window.scrollY - (starts.get(f) ?? 0));
				f.style.setProperty('--wisp-rise', `${past * RISE}px`);
				f.style.setProperty('--wisp-away', String(Math.min(1, past / (vh * FADE))));
			});
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		fields.forEach((f) => io.observe(f));
		measure();
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			measure();
			update();
		});
	}
</script>

<style>
	.wisp-field {
		position: relative;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.wisp-field__inner {
		position: absolute;
		inset: 0;
		transform: translateY(calc(var(--wisp-rise, 0px) * -1));
		opacity: calc(1 - var(--wisp-away, 0));
	}

	/* ---------- Fade in, one after another ---------- */
	:global(.js-wisps) .wisp,
	:global(.js-wisps) .wisp-field__sparks {
		opacity: 0;
		transition: opacity var(--duration-wisp-fade) var(--ease-drift);
		transition-delay: calc(var(--i) * var(--duration-wisp-fade) / 3);
	}
	.wisp-field[data-lit] .wisp,
	.wisp-field[data-lit] .wisp-field__sparks {
		opacity: 1;
	}
	/* Pause the flicker and drift while off screen */
	:global(.js-wisps) .wisp-field:not([data-visible]) * {
		animation-play-state: paused;
	}

	/* ---------- A wisp ---------- */
	.wisp {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: calc(var(--size-wisp) * var(--s));
		aspect-ratio: 1;
		mix-blend-mode: screen;
		animation: wisp-drift var(--duration-wisp-drift) var(--ease-drift) infinite alternate;
		animation-delay: calc(var(--i) * var(--duration-wisp-drift) / -3);
	}
	.wisp__halo {
		position: absolute;
		inset: -70%;
		border-radius: var(--radius-round);
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--color-aqua-glow) 35%, transparent),
			color-mix(in srgb, var(--color-aqua-glow) 10%, transparent) 55%,
			transparent
		);
		animation: wisp-pulse calc(var(--duration-flicker) * 1.7) var(--ease-drift) infinite alternate;
		animation-delay: calc(var(--i) * var(--duration-flicker) / -2);
	}
	.wisp__flame {
		position: absolute;
		inset: 0;
		border-radius: var(--radius-round);
		background: radial-gradient(
			circle closest-side at 50% 50%,
			var(--color-white) 0 34%,
			var(--color-aqua-glow) 72%,
			color-mix(in srgb, var(--color-aqua-glow) 60%, transparent) 92%,
			transparent
		);
		filter: blur(var(--size-wisp-blur));
		animation: wisp-flicker var(--duration-flicker) var(--ease-drift) infinite alternate;
		animation-delay: calc(var(--i) * var(--duration-flicker) / -3);
	}

	/* ---------- Sparks ---------- */
	.wisp-field__sparks {
		position: absolute;
		inset: 0;
	}
	.wisp-field__spark {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--size-spark);
		aspect-ratio: 1;
		border-radius: var(--radius-round);
		background: var(--color-white);
		box-shadow:
			0 0 var(--size-spark) var(--color-aqua-glow),
			0 0 calc(var(--size-spark) * 4) var(--color-aqua-glow);
		animation: wisp-twinkle var(--duration-flicker) var(--ease-drift) infinite alternate;
		animation-delay: calc(var(--i) * var(--duration-flicker) / -4);
	}

	@keyframes wisp-drift {
		0% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(18%, -30%);
		}
		100% {
			transform: translate(-12%, -55%);
		}
	}
	@keyframes wisp-flicker {
		0% {
			border-radius: 50%;
			scale: 1 1;
			opacity: 0.85;
		}
		35% {
			border-radius: 46% 54% 50% 50% / 52% 50% 50% 48%;
			scale: 0.95 1.05;
			opacity: 1;
		}
		70% {
			border-radius: 53% 47% 48% 52% / 48% 53% 47% 52%;
			scale: 1.05 0.96;
			opacity: 0.75;
		}
		100% {
			border-radius: 50% 50% 46% 54% / 50% 48% 52% 50%;
			scale: 0.98 1.02;
			opacity: 0.95;
		}
	}
	@keyframes wisp-pulse {
		from {
			opacity: 0.6;
			transform: scale(0.9);
		}
		to {
			opacity: 1;
			transform: scale(1.1);
		}
	}
	@keyframes wisp-twinkle {
		0%,
		40% {
			opacity: 0.15;
		}
		100% {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.wisp,
		.wisp__halo,
		.wisp__flame,
		.wisp-field__spark {
			animation: none;
		}
	}
</style>
