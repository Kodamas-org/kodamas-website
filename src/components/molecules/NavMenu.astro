---
// Header navigation: text links plus a call-to-action button.
// On small screens the text links fold into a menu icon button.
import Link from '../atoms/Link.astro';
import Button from '../atoms/Button.astro';

interface Props {
	links: { label: string; href: string }[];
	cta: { label: string; href: string };
}

const { links, cta } = Astro.props;
---

<nav class="nav-menu" aria-label="Main">
	<button
		class="nav-menu__toggle"
		type="button"
		aria-expanded="false"
		aria-controls="nav-menu-list"
		aria-label="Menu"
	>
		<svg class="nav-menu__icon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"
			></path>
		</svg>
	</button>
	<ul class="nav-menu__list" id="nav-menu-list" role="list">
		{
			links.map((link) => (
				<li>
					<Link href={link.href} variant="nav" tone="aqua">
						{link.label}
					</Link>
				</li>
			))
		}
	</ul>
	<Button href={cta.href} variant="primary" size="m">{cta.label}</Button>
</nav>

<script>
	document.querySelectorAll<HTMLElement>('.nav-menu').forEach((nav) => {
		const toggle = nav.querySelector<HTMLButtonElement>('.nav-menu__toggle');
		toggle?.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!open));
		});
	});
</script>

<style>
	.nav-menu {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}
	.nav-menu__list {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}
	.nav-menu__toggle {
		display: none;
		place-items: center;
		width: var(--size-tap-min);
		height: var(--size-tap-min);
		padding: 0;
		background: none;
		border: var(--border-width-thin) solid var(--color-aqua-glow);
		border-radius: var(--radius-pill);
		color: var(--color-aqua-glow);
		cursor: pointer;
	}
	.nav-menu__icon {
		width: var(--size-icon);
		height: var(--size-icon);
	}

	@media (max-width: 48rem) {
		.nav-menu {
			gap: var(--space-3);
		}
		.nav-menu__toggle {
			display: grid;
		}
		.nav-menu__list {
			display: none;
			position: absolute;
			top: calc(100% + var(--space-3));
			right: 0;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2);
			padding: var(--space-3) var(--space-5);
			background: var(--color-midnight-navy);
			border: var(--border-width-thin) solid var(--color-aqua-glow);
			border-radius: var(--radius-s);
		}
		.nav-menu__list :global(.link) {
			display: flex;
			align-items: center;
			min-height: var(--size-tap-min);
		}
		.nav-menu__toggle[aria-expanded='true'] + .nav-menu__list {
			display: flex;
		}
	}
</style>
