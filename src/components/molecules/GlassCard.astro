---
// Frosted, translucent card that lets the animated background show through.
// Text is navy for contrast on the light glass.
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

interface Props {
	title: string;
	level?: 2 | 3;
}

const { title, level = 3 } = Astro.props;
---

<div class="glass-card">
	<Heading level={level} size="heading-3">{title}</Heading>
	<Text><slot /></Text>
</div>

<style>
	.glass-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-8);
		background: var(--color-glass-fill);
		border: var(--border-width-thin) solid var(--color-glass-edge);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-glass);
		backdrop-filter: blur(var(--blur-glass));
		-webkit-backdrop-filter: blur(var(--blur-glass));
		color: var(--color-text-on-light);
	}

	@media (max-width: 48rem) {
		.glass-card {
			padding: var(--space-6);
		}
	}
</style>
