---
// Footer navigation item: a small pink drop next to an arrow link.
import Drop from '../atoms/Drop.astro';
import Link from '../atoms/Link.astro';

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<span class="footer-link">
	<Drop size="s" tone="flat" />
	<Link href={href} variant="arrow" tone="white"><slot /></Link>
</span>

<style>
	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--size-tap-min);
		font-size: var(--font-size-body);
		line-height: var(--line-height-ui);
	}
</style>
