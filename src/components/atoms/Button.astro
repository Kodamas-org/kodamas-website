---
// Pill-shaped button. Renders a link when `href` is given, otherwise a <button>.
// variant: 'primary' (aqua with navy text) or 'inverse' (white with pink text)
// size: 's' compact, desktop only · 'm' default (header, footer) ·
//       'l' the single main action on a page
interface Props {
	href?: string;
	variant?: 'primary' | 'inverse';
	size?: 's' | 'm' | 'l';
	type?: 'button' | 'submit';
	class?: string;
}

const { href, variant = 'primary', size = 'm', type = 'button', class: className } = Astro.props;
const classes = ['button', `button--${variant}`, `button--${size}`, className];
---

{
	href ? (
		<a href={href} class:list={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes}>
			<slot />
		</button>
	)
}

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-ui);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: transform var(--duration-fast) var(--ease-standard);
		--focus-color: var(--color-focus-on-dark);
	}
	.button:hover {
		transform: translateY(calc(var(--space-1) * -0.5));
	}
	.button--s {
		min-height: var(--button-height-s);
		padding-inline: var(--button-padding-s);
		font-size: var(--font-size-small);
	}
	.button--m {
		min-height: var(--button-height-m);
		padding-inline: var(--button-padding-m);
		font-size: var(--font-size-ui);
	}
	.button--l {
		min-height: var(--button-height-l);
		padding-inline: var(--button-padding-l);
		font-size: var(--font-size-body);
	}
	.button--primary {
		background: var(--color-aqua-glow);
		color: var(--color-midnight-navy);
	}
	.button--inverse {
		background: var(--color-white);
		color: var(--color-pink-deep);
		--focus-color: var(--color-white);
	}
</style>
