---
// Pill-shaped button. Renders a link when `href` is given, otherwise a <button>.
// variant: 'aqua' (aqua with navy text, on navy) or 'navy' (on the aqua surface)
// size: 'm' (header) or 'l' (page calls to action)
// An external href (http/https, e.g. Calendly) opens in a new tab and says so
// to screen readers.
interface Props {
	href?: string;
	variant?: 'aqua' | 'navy';
	size?: 'm' | 'l';
	type?: 'button' | 'submit';
	class?: string;
}

const { href, variant = 'aqua', size = 'l', type = 'button', class: className } = Astro.props;
const classes = ['button', `button--${variant}`, `button--${size}`, className];
const external = href ? /^https?:\/\//.test(href) : false;
---

{
	href ? (
		<a
			href={href}
			class:list={classes}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener' : undefined}
		>
			<slot />
			{external && <span class="visually-hidden"> (opens in a new tab)</span>}
		</a>
	) : (
		<button type={type} class:list={classes}>
			<slot />
		</button>
	)
}

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			transform var(--duration-fast) var(--ease-standard),
			box-shadow var(--duration-base) var(--ease-standard);
	}
	.button:hover {
		transform: translateY(calc(var(--space-1) * -0.5));
	}
	.button--m {
		padding: var(--space-4) var(--space-5);
		font-size: var(--font-size-ui);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-height-ui);
	}
	.button--l {
		min-height: var(--size-button-l);
		padding-inline: var(--space-6);
		font-size: var(--font-size-body);
		font-weight: var(--font-weight-semibold);
	}
	.button--aqua {
		background: var(--color-aqua-glow);
		color: var(--color-midnight-navy);
	}
	.button--aqua.button--l:hover {
		box-shadow: 0 0 0 var(--space-2) var(--color-button-glow);
	}
	.button--navy {
		background: var(--color-midnight-navy);
		color: var(--color-white);
	}
	@media (max-width: 48rem) {
		.button--m {
			padding: var(--space-3);
		}
	}
</style>
