---
// A photo cropped to a shape (portraits, case photos). With `src` it shows
// the photo with a fine grain over it, like the rest of the page; without
// it, a dashed placeholder that says a photo is still needed.
// src: an imported image (optimised and resized by Astro) or a URL
// shape: 'round' (testimonial byline) or 'drop' (portraits, case photos)
// size: 's' (3.5rem byline) or 'l' (fills its column, up to the team width)
// focus: which part of the photo stays in the crop, as an object-position
//        (e.g. '70% 50%' for a subject on the right); default keeps faces
// sizes: how wide the photo shows, so the browser picks the right file
//        (the parent knows its column; the defaults are safe upper bounds)
// priority: true for a photo visible on load (loads first, not lazily)
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	name: string;
	src?: ImageMetadata | string;
	alt?: string;
	shape?: 'round' | 'drop';
	size?: 's' | 'l';
	focus?: string;
	sizes?: string;
	priority?: boolean;
	class?: string;
}

const {
	name,
	src,
	alt,
	shape = 'round',
	size = 's',
	focus,
	sizes = size === 's' ? '3.5rem' : '(max-width: 48rem) 80vw, 32rem',
	priority = false,
	class: className,
} = Astro.props;
const initials = name
	.split(/\s+/)
	.map((w) => w[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
const classes = ['avatar', `avatar--${shape}`, `avatar--${size}`, className];

// Imported images get resized copies in AVIF (smallest) with a WebP
// fallback: small for bylines, larger for columns. The largest width is
// also the fallback src, so the original file is never sent.
const widths = size === 's' ? [112, 168, 224] : [400, 640, 960, 1280];
const variant = (format: 'avif' | 'webp') =>
	getImage({ src: src as ImageMetadata, format, widths, width: Math.max(...widths), quality: 70 });
const [avif, webp] =
	src && typeof src !== 'string' ? await Promise.all([variant('avif'), variant('webp')]) : [undefined, undefined];
---

{
	src ? (
		<span class:list={classes} style={focus ? `--avatar-focus: ${focus}` : undefined}>
			<picture>
				{avif && <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />}
				<img
					class="avatar__img"
					src={webp ? webp.src : (src as string)}
					srcset={webp?.srcSet.attribute}
					sizes={webp ? sizes : undefined}
					alt={alt ?? name}
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : undefined}
					decoding="async"
				/>
			</picture>
		</span>
	) : (
		<div class:list={[...classes, 'avatar--placeholder']} role="img" aria-label={`${name} (photo needed)`}>
			<span aria-hidden="true">
				{size === 's' ? (
					initials
				) : (
					<>
						Photo needed:
						<br />
						{name}
					</>
				)}
			</span>
		</div>
	)
}

<style>
	.avatar {
		position: relative;
		display: block;
		flex-shrink: 0;
		aspect-ratio: 1;
		overflow: hidden;
		transition: border-radius var(--duration-base) var(--ease-standard);
	}
	.avatar picture {
		display: contents;
	}
	.avatar__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--avatar-focus, var(--position-portrait));
	}
	/* A rough film grain over the photo, moving like film (still for
	   reduced motion); grain-shift lives in global.css */
	.avatar:not(.avatar--placeholder)::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: var(--texture-grain-photo);
		opacity: var(--opacity-grain-photo);
		mix-blend-mode: overlay;
		pointer-events: none;
		animation: grain-shift var(--duration-grain) steps(1) infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.avatar::after {
			animation: none;
		}
	}
	.avatar--s {
		width: var(--size-avatar-s);
	}
	.avatar--l {
		width: 100%;
		max-width: var(--layout-team-column);
	}
	.avatar--round {
		border-radius: var(--radius-round);
	}
	.avatar--drop {
		border-radius: var(--radius-drop);
	}
	.avatar--placeholder {
		display: grid;
		place-items: center;
		background: var(--color-placeholder);
		border: var(--border-width-medium) dashed var(--color-aqua-glow);
		color: var(--color-white);
		text-align: center;
	}
	.avatar--placeholder span {
		padding: var(--space-2);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-tight);
	}
</style>
