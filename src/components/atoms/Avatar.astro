---
// A portrait. With `src` it shows the photo cropped to the shape; without it,
// a dashed placeholder that says a photo is still needed.
// shape: 'round' (testimonial byline) or 'drop' (team portraits)
// size: 's' (3.5rem byline) or 'l' (fills its column, up to the team width)
interface Props {
	name: string;
	src?: string;
	alt?: string;
	shape?: 'round' | 'drop';
	size?: 's' | 'l';
	class?: string;
}

const { name, src, alt, shape = 'round', size = 's', class: className } = Astro.props;
const initials = name
	.split(/\s+/)
	.map((w) => w[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
const classes = ['avatar', `avatar--${shape}`, `avatar--${size}`, className];
---

{
	src ? (
		<img class:list={classes} src={src} alt={alt ?? name} loading="lazy" decoding="async" />
	) : (
		<div class:list={[...classes, 'avatar--placeholder']} role="img" aria-label={`${name} (photo needed)`}>
			<span aria-hidden="true">
				{size === 's' ? (
					initials
				) : (
					<>
						Photo needed:
						<br />
						{name}
					</>
				)}
			</span>
		</div>
	)
}

<style>
	.avatar {
		flex-shrink: 0;
		aspect-ratio: 1;
		object-fit: cover;
		transition: border-radius var(--duration-base) var(--ease-standard);
	}
	.avatar--s {
		width: var(--size-avatar-s);
	}
	.avatar--l {
		width: 100%;
		max-width: var(--layout-team-column);
	}
	.avatar--round {
		border-radius: var(--radius-round);
	}
	.avatar--drop {
		border-radius: var(--radius-drop);
	}
	.avatar--placeholder {
		display: grid;
		place-items: center;
		background: var(--color-placeholder);
		border: var(--border-width-medium) dashed var(--color-aqua-glow);
		color: var(--color-white);
		text-align: center;
	}
	.avatar--placeholder span {
		padding: var(--space-2);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-tight);
	}
</style>
