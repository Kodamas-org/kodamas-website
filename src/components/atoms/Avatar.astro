---
// Portrait photo.
// shape: 'drop' (team) or 'circle' (testimonials)
// size: 'team' or 'testimonial'
// Without `src` it shows a labelled placeholder until the real photo arrives
// (the full label on large avatars, initials on small ones).
interface Props {
	src?: string;
	alt: string;
	shape?: 'drop' | 'circle';
	size?: 'team' | 'testimonial';
	class?: string;
}

const { src, alt, shape = 'circle', size = 'testimonial', class: className } = Astro.props;
const classes = ['avatar', `avatar--${shape}`, `avatar--${size}`, className];
const initials = alt
	.split(/\s+/)
	.map((word) => word[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
---

{
	src ? (
		<img src={src} alt={alt} class:list={classes} loading="lazy" decoding="async" />
	) : (
		<div class:list={[...classes, 'avatar--placeholder']} role="img" aria-label={`${alt} (photo needed)`}>
			<span class="avatar__label" aria-hidden="true">
				{size === 'team' ? (
					<>
						Photo needed:
						<br />
						{alt}
					</>
				) : (
					initials
				)}
			</span>
		</div>
	)
}

<style>
	.avatar {
		display: block;
		flex-shrink: 0;
		aspect-ratio: 1;
		object-fit: cover;
	}
	.avatar--team {
		width: var(--size-avatar-team);
	}
	.avatar--testimonial {
		width: var(--size-avatar-testimonial);
	}
	.avatar--drop {
		border-radius: var(--radius-drop);
	}
	.avatar--circle {
		border-radius: var(--radius-round);
	}
	.avatar--placeholder {
		display: grid;
		place-items: center;
		background: var(--color-control-teal);
		border: var(--border-width-medium) dashed var(--color-aqua-glow);
		color: var(--color-white);
		text-align: center;
	}
	.avatar__label {
		padding: var(--space-2);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-ui);
	}
</style>
