---
// Centres content on the 12-column grid: 1280px wide at most, plus the
// side gutters. Every section's content sits inside one.
interface Props {
	as?: 'div' | 'header' | 'footer' | 'nav';
	class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', className]}><slot /></Tag>

<style>
	.container {
		max-width: calc(var(--layout-max) + 2 * var(--layout-gutter));
		margin-inline: auto;
		padding-inline: var(--layout-gutter);
	}
</style>
