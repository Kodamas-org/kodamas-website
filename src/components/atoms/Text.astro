---
// Body text in Inter.
// size: 'body' (default), 'lead' (larger paragraph), 'small'
// tone: 'inherit' or 'muted' (aqua-grey for captions and meta on navy)
// Links inside are underlined in the accent colour.
interface Props {
	as?: 'p' | 'span' | 'div';
	size?: 'body' | 'lead' | 'small';
	tone?: 'inherit' | 'muted';
	class?: string;
}

const { as: Tag = 'p', size = 'body', tone = 'inherit', class: className } = Astro.props;
---

<Tag class:list={['text', `text--${size}`, `text--${tone}`, className]}><slot /></Tag>

<style>
	.text--body {
		font-size: var(--font-size-body);
		line-height: var(--line-height-body);
	}
	.text--lead {
		font-size: var(--font-size-lead);
		line-height: var(--line-height-lead);
	}
	.text--small {
		font-size: var(--font-size-small);
		line-height: var(--line-height-lead);
	}
	.text--muted {
		color: var(--color-text-muted);
	}
	.text :global(a) {
		color: var(--color-accent);
		text-underline-offset: var(--size-underline-offset);
	}
	.text :global(strong) {
		font-weight: var(--font-weight-bold);
	}
</style>
