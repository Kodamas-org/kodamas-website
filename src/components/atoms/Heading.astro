---
// Heading in Funnel Display. The level (document structure) and the size
// (look) are chosen separately, so the outline stays correct.
// size: 'l' section titles (h2 scale) · 'm' names (h3 scale) ·
//       's' card titles (lead scale)
interface Props {
	level: 1 | 2 | 3 | 4 | 5 | 6;
	size?: 'l' | 'm' | 's';
	align?: 'start' | 'center';
	class?: string;
	id?: string;
}

const { level, size = 'l', align = 'start', class: className, id } = Astro.props;
const Tag = `h${level}` as const;
---

<Tag id={id} class:list={['heading', `heading--${size}`, `heading--${align}`, className]}><slot /></Tag>

<style>
	.heading {
		font-family: var(--font-display);
		font-weight: var(--font-weight-bold);
	}
	.heading--l {
		font-size: var(--font-size-h2);
		line-height: var(--line-height-heading);
	}
	.heading--m {
		font-size: var(--font-size-h3);
		line-height: var(--line-height-snug);
	}
	.heading--s {
		font-size: var(--font-size-lead);
		line-height: var(--line-height-snug);
	}
	.heading--start {
		text-align: start;
	}
	.heading--center {
		text-align: center;
	}
</style>
