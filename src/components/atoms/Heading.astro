---
// A title in Funnel Display.
// level: the heading level (choose by page structure)
// size: 'statement' (large Light line; <em> inside turns aqua bold),
//       'l' (section title, Bold), 'm' (item title, Bold)
// tone: 'inherit' (text colour of the surface) or 'aqua'
interface Props {
	level?: 1 | 2 | 3 | 4;
	size?: 'statement' | 'l' | 'm';
	tone?: 'inherit' | 'aqua';
	id?: string;
	class?: string;
	reveal?: boolean;
}

const { level = 2, size = 'l', tone = 'inherit', id, class: className, reveal = false } = Astro.props;
const Tag = `h${level}` as 'h2';
---

<Tag id={id} class:list={['heading', `heading--${size}`, `heading--${tone}`, className]} data-reveal={reveal || undefined}>
	<slot />
</Tag>

<style>
	.heading {
		font-family: var(--font-display);
		letter-spacing: var(--letter-spacing-display);
		text-wrap: balance;
	}
	.heading--statement {
		font-size: var(--font-size-statement);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-heading);
	}
	.heading--statement :global(em) {
		font-style: normal;
		font-weight: var(--font-weight-bold);
		color: var(--color-accent);
	}
	.heading--l {
		font-size: var(--font-size-heading-2);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-heading);
	}
	.heading--m {
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-snug);
		letter-spacing: var(--letter-spacing-body);
	}
	.heading--aqua {
		color: var(--color-accent);
	}
</style>
