---
// A small uppercase label that introduces a group ("What’s Covered").
// tone: 'inherit' (text colour of the surface) or 'pink' (the editorial
//       pink of section numbers, --color-number)
interface Props {
	as?: 'p' | 'h1' | 'h2' | 'h3' | 'span';
	id?: string;
	tone?: 'inherit' | 'pink';
	class?: string;
}

const { as: Tag = 'p', id, tone = 'inherit', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--${tone}`, className]} id={id}><slot /></Tag>

<style>
	.eyebrow {
		font-family: var(--font-body);
		font-size: var(--font-size-small);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
	}
	.eyebrow--pink {
		color: var(--color-number);
	}
</style>
