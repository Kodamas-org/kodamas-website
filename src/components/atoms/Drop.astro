---
// The Kodamas drop: a shape with a square top-left corner and three rounded
// corners. Decorative only, so it is hidden from screen readers.
// size: 'xs' (footer mark), 's' (markers, compact counter), 'm' (quote mark)
// tone: 'pink' (pink gradient with the moving film grain of the photos),
//       'aqua' (solid aqua) or 'outline' (aqua line)
// symbol: an optional '+' or '=' drawn inside (used by the name equation)
interface Props {
	size?: 'xs' | 's' | 'm';
	tone?: 'pink' | 'aqua' | 'outline';
	symbol?: '+' | '=';
	class?: string;
}

const { size = 's', tone = 'pink', symbol, class: className } = Astro.props;
---

<span class:list={['drop', `drop--${size}`, `drop--${tone}`, className]} aria-hidden="true">
	{
		symbol === '+' && (
			<svg class="drop__symbol" viewBox="0 0 24 24">
				<path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
			</svg>
		)
	}
	{
		symbol === '=' && (
			<svg class="drop__symbol" viewBox="0 0 24 24">
				<path d="M5 9h14M5 15h14" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
			</svg>
		)
	}
</span>

<style>
	.drop {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		aspect-ratio: 1;
		border-radius: var(--radius-drop);
		color: var(--color-white);
	}
	.drop--xs {
		width: var(--size-drop-xs);
	}
	.drop--s {
		width: var(--size-drop-s);
	}
	.drop--m {
		width: var(--size-drop-m);
	}
	.drop--pink {
		position: relative;
		overflow: hidden;
		background: var(--gradient-drop);
	}
	/* The same moving film grain as the photos (still for reduced motion) */
	.drop--pink::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-image: var(--texture-grain-photo);
		opacity: var(--opacity-grain-photo);
		mix-blend-mode: overlay;
		pointer-events: none;
		animation: grain-shift var(--duration-grain) steps(1) infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.drop--pink::after {
			animation: none;
		}
	}
	.drop--aqua {
		background: var(--color-aqua-glow);
	}
	.drop--outline {
		border: var(--border-width-medium) solid var(--color-aqua-glow);
	}
	.drop__symbol {
		width: 45%;
	}
</style>
