---
// The name "Kodamas" in Funnel Display, in aqua.
// variant: 'header' (Bold, top bar) or 'signoff' (Heavy, with a small pink
//          drop before it, footer bar)
interface Props {
	variant?: 'header' | 'signoff';
}

const { variant = 'header' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${variant}`]}>
	{variant === 'signoff' && <span class="wordmark__drop" aria-hidden="true" />}Kodamas
</span>

<style>
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--font-size-wordmark-s);
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--letter-spacing-display);
		line-height: var(--line-height-none);
		color: var(--color-aqua-glow);
	}
	.wordmark--signoff {
		font-weight: var(--font-weight-heavy);
		line-height: inherit;
	}
	.wordmark__drop {
		width: var(--size-drop-xs);
		aspect-ratio: 1;
		border-radius: var(--radius-drop);
		background: var(--gradient-drop);
	}
</style>
