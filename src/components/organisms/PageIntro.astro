---
// The opening of a simple page (e.g. Blogfolio): a small pink label with a
// drop, the page title as the h1 set as a large statement (key word in <em>
// turns aqua bold), and an intro paragraph. Each part rises in turn.
// label: the small label above the title
// back: optional link above the label, back to the parent page (articles)
// Slots: "title" (the h1 content), default (the intro paragraph),
//        "meta" (optional small line under the intro: author, date…)
import Container from '../atoms/Container.astro';
import DropLabel from '../molecules/DropLabel.astro';
import Heading from '../atoms/Heading.astro';

interface Props {
	label?: string;
	back?: { label: string; href: string };
}

const { label, back } = Astro.props;
---

<div class="page-intro">
	<Container>
		{
			back && (
				<a class="page-intro__back" href={back.href} style="--step: 0">
					<span aria-hidden="true">←</span> {back.label}
				</a>
			)
		}
		{
			label && (
				<div class="page-intro__label" style="--step: 0">
					<DropLabel>{label}</DropLabel>
				</div>
			)
		}
		<div class="page-intro__title" style="--step: 1">
			<Heading level={1} size="statement"><slot name="title" /></Heading>
		</div>
		{Astro.slots.has('default') && <p class="page-intro__lead" style="--step: 2"><slot /></p>}
		{
			Astro.slots.has('meta') && (
				<p class="page-intro__meta" style="--step: 2">
					<slot name="meta" />
				</p>
			)
		}
	</Container>
</div>

<style>
	.page-intro {
		padding-top: var(--space-8);
	}
	.page-intro__back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--size-tap-min);
		margin-bottom: var(--space-4);
		font-weight: var(--font-weight-semibold);
		color: var(--color-accent);
		text-decoration: none;
	}
	.page-intro__back:hover {
		text-decoration: underline;
		text-underline-offset: var(--size-underline-offset);
	}
	.page-intro__title {
		margin-top: var(--space-6);
	}
	.page-intro__lead {
		max-width: var(--layout-text-max);
		margin-top: var(--space-7);
		margin-left: auto;
		font-size: var(--font-size-lead);
		line-height: var(--line-height-lead);
		text-wrap: pretty;
	}

	.page-intro__meta {
		max-width: var(--layout-text-max);
		margin-top: var(--space-4);
		margin-left: auto;
		font-size: var(--font-size-small);
		color: var(--color-text-muted);
	}

	/* ---------- Motion: label, title, intro rise one beat apart ---------- */
	.page-intro__back,
	.page-intro__label,
	.page-intro__title,
	.page-intro__lead,
	.page-intro__meta {
		animation: rise var(--duration-rise) var(--ease-standard) both;
		animation-delay: calc(var(--step) * var(--duration-beat) / 2);
	}
	@media (prefers-reduced-motion: reduce) {
		.page-intro__back,
		.page-intro__label,
		.page-intro__title,
		.page-intro__lead,
		.page-intro__meta {
			animation: none;
		}
	}
</style>
