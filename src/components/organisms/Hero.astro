---
// Opening section: the large two-tone "Kodamas" wordmark with a pink drop
// tucked behind the K, followed by the intro paragraph. The K and the
// paragraph share the container's left edge; the drop sits in the margin.
import Wordmark from '../atoms/Wordmark.astro';
import Drop from '../atoms/Drop.astro';
import Text from '../atoms/Text.astro';
---

<section class="hero container" aria-labelledby="hero-title">
	<div class="hero__inner">
		<Drop size="l" class="hero__drop" />
		<h1 id="hero-title" class="hero__wordmark"><Wordmark size="xl" tone="two-tone" /></h1>
		<Text size="l" class="hero__intro"><slot /></Text>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-section);
	}
	.hero__inner {
		position: relative;
		padding-top: var(--overlap-hero-drop);
	}
	.hero :global(.hero__drop) {
		position: absolute;
		top: 0;
		/* The drop sits in the page margin so the K lines up with every other section */
		left: calc(-1 * min(var(--overlap-hero-drop), var(--layout-gutter)));
	}
	.hero__wordmark {
		position: relative;
		font-size: inherit;
	}
	.hero :global(.hero__intro) {
		max-width: var(--layout-text-max);
		margin-top: var(--space-8);
	}

	@media (max-width: 48rem) {
		.hero :global(.hero__intro) {
			margin-top: var(--space-6);
		}
	}
</style>
