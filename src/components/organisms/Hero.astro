---
// The homepage opening. The giant wordmark (the page's h1) fills the grid
// width exactly, its letters rising in one after another; the first letters
// are white, the rest aqua. Below it the intro statement and actions on the
// left, the floating drop cluster on the right (above the wordmark on
// tablet and mobile).
// word / lead: the wordmark and how many leading letters are white
// Slots: default (the intro statement; wrap the key phrase in
//        <Highlight variant="underline">), "actions" (button and link)
import Container from '../atoms/Container.astro';
import DropCluster from '../molecules/DropCluster.astro';

interface Props {
	word?: string;
	lead?: number;
}

const { word = 'Kodamas', lead = 2 } = Astro.props;
const letters = [...word];
---

<div class="hero">
	<Container>
		<h1 class="hero__mark">
			<span class="visually-hidden">{word}</span>
			<span class="hero__letters" aria-hidden="true">
				{
					letters.map((l, i) => (
						<span class:list={['hero__letter', { 'hero__letter--lead': i < lead }]} style={`--i: ${i}`}>
							{l}
						</span>
					))
				}
			</span>
		</h1>
		<div class="hero__foot">
			<div class="hero__text">
				<p class="hero__intro"><slot /></p>
				<div class="hero__actions"><slot name="actions" /></div>
			</div>
			<div class="hero__symbol">
				<DropCluster />
			</div>
		</div>
	</Container>
</div>

<style>
	.hero {
		position: relative;
		padding-top: var(--space-8);
		padding-bottom: var(--layout-section);
	}
	.hero__mark {
		position: relative;
		container-type: inline-size;
		margin-top: var(--space-6);
	}
	.hero__letters {
		display: block;
		font-family: var(--font-display);
		font-size: var(--font-size-mark);
		font-weight: var(--font-weight-heavy);
		line-height: var(--line-height-mark);
		letter-spacing: var(--letter-spacing-tight);
		color: var(--color-aqua-glow);
		white-space: nowrap;
	}
	.hero__letter {
		display: inline-block;
		animation: rise var(--duration-rise) var(--ease-standard) both;
		animation-delay: calc(var(--i) * var(--stagger));
	}
	.hero__letter--lead {
		color: var(--color-white);
	}
	.hero__foot {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--layout-col-gap);
		row-gap: var(--space-6);
		align-items: center;
		margin-top: var(--space-8);
	}
	.hero__text {
		grid-column: 1 / span 8;
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
	}
	.hero__intro {
		font-family: var(--font-display);
		font-size: var(--font-size-intro);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
		text-wrap: pretty;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-6);
	}
	.hero__symbol {
		grid-column: 10 / -1;
		justify-self: end;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__letter {
			animation: none;
		}
	}
	@media (max-width: 64rem) {
		.hero__text {
			grid-column: 1 / -1;
		}
		/* The symbol returns above the wordmark */
		.hero__symbol {
			position: absolute;
			top: var(--space-6);
			right: var(--layout-gutter);
		}
		.hero__mark {
			margin-top: calc(var(--size-drop-cluster) * 0.82);
		}
	}
</style>
