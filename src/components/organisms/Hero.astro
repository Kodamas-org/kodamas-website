---
// The homepage opening. The giant wordmark (the page's h1) fills the grid
// width exactly, its letters rising in one after another; the first letters
// are white, the rest aqua. Below it the intro statement and actions on the
// left, the floating drop cluster on the right (above the wordmark on
// tablet and mobile).
// Slots: default (the intro statement; wrap the key phrase in
//        <Highlight variant="underline">), "actions" (button and link)
import Container from '../atoms/Container.astro';
import Wordmark from '../atoms/Wordmark.astro';
import DropCluster from '../molecules/DropCluster.astro';
---

<div class="hero">
	<Container>
		<h1 class="hero__mark">
			<span class="visually-hidden">Kodamas</span>
			<Wordmark variant="giant" />
		</h1>
		<div class="hero__foot">
			<div class="hero__text">
				<p class="hero__intro"><slot /></p>
				<div class="hero__actions"><slot name="actions" /></div>
			</div>
			<div class="hero__symbol">
				<DropCluster />
			</div>
		</div>
	</Container>
</div>

<style>
	.hero {
		position: relative;
		padding-top: var(--space-8);
		padding-bottom: var(--layout-section);
	}
	.hero__mark {
		position: relative;
		margin-top: var(--space-6);
	}
	.hero__foot {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--layout-col-gap);
		row-gap: var(--space-6);
		align-items: center;
		margin-top: var(--space-8);
	}
	.hero__text {
		grid-column: 1 / span 8;
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
	}
	.hero__intro {
		font-family: var(--font-display);
		font-size: var(--font-size-intro);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
		text-wrap: pretty;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-6);
	}
	.hero__symbol {
		grid-column: 10 / -1;
		justify-self: end;
	}

	@media (max-width: 64rem) {
		.hero__text {
			grid-column: 1 / -1;
		}
		/* The symbol returns above the wordmark */
		.hero__symbol {
			position: absolute;
			top: var(--space-6);
			right: var(--layout-gutter);
		}
		.hero__mark {
			margin-top: calc(var(--size-drop-cluster) * 0.82);
		}
	}
</style>
