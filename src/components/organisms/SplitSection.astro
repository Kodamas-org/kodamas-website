---
// Two-column section on the navy background: a section title on the left
// and content on the right. Stacks on tablet and mobile.
// Two SplitSections in a row share one section gap instead of doubling it.
// align: vertical alignment of the two columns
import Heading from '../atoms/Heading.astro';

interface Props {
	title: string;
	id: string;
	align?: 'start' | 'center';
}

const { title, id, align = 'start' } = Astro.props;
---

<section class:list={['split', 'container', `split--${align}`]} aria-labelledby={id}>
	<Heading level={2} size="l" id={id}>{title}</Heading>
	<div class="split__body">
		<slot />
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--space-9);
		row-gap: var(--space-6);
		padding-block: var(--space-section);
	}
	.split + .split {
		padding-top: 0;
	}
	.split--center {
		align-items: center;
	}
	.split__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: var(--layout-text-max);
	}

	@media (max-width: 64rem) {
		.split {
			grid-template-columns: 1fr;
		}
	}
</style>
