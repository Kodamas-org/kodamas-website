---
// Two-column section on the navy background: a large heading on the left
// and content on the right. Stacks on tablet and mobile.
// headingSize: 'display-l' ("Keep Going") or 'heading-1' ("Why is…")
// align: vertical alignment of the two columns
import Heading from '../atoms/Heading.astro';

interface Props {
	title: string;
	id: string;
	headingSize?: 'display-l' | 'heading-1';
	align?: 'start' | 'center';
}

const { title, id, headingSize = 'display-l', align = 'start' } = Astro.props;
---

<section class:list={['split', `split--${align}`]} aria-labelledby={id}>
	<Heading level={2} size={headingSize} id={id}>{title}</Heading>
	<div class="split__body">
		<slot />
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--space-10);
		row-gap: var(--space-7);
		max-width: var(--layout-container-max);
		margin-inline: auto;
		padding: var(--space-10) var(--layout-gutter);
	}
	.split--center {
		align-items: center;
	}
	.split__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	@media (max-width: 64rem) {
		.split {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 48rem) {
		.split {
			padding-block: var(--space-9);
		}
	}
</style>
