---
// The page footer: large navigation rows (FooterLink), then a bar with the
// sign-off wordmark, the copyright line and the legal link.
import Container from '../atoms/Container.astro';
import Wordmark from '../atoms/Wordmark.astro';
import Link from '../atoms/Link.astro';
import FooterLink from '../molecules/FooterLink.astro';
import { footerNav, pages } from '../../data/navigation';

---

<footer class="site-footer">
	<Container>
		<nav aria-label="Footer">
			<ul class="site-footer__list" role="list">
				{footerNav.map((l) => <FooterLink href={l.href}>{l.label}</FooterLink>)}
			</ul>
		</nav>
		<div class="site-footer__bar">
			<span aria-hidden="true"><Wordmark variant="signoff" /></span>
			<span>All rights reserved 2026 ©</span>
			<Link href={pages.privacyTerms.href} variant="legal" tone="white">{pages.privacyTerms.label}</Link>
		</div>
	</Container>
</footer>

<style>
	.site-footer {
		padding-top: var(--space-9);
	}
	.site-footer__list {
		border-top: var(--border-width-thin) solid var(--color-rule);
	}
	.site-footer__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4) var(--space-6);
		padding-block: var(--space-7);
		font-size: var(--font-size-small);
		color: var(--color-text-muted);
	}
	@media (max-width: 48rem) {
		.site-footer__bar {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
