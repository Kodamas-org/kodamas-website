---
// Page footer: a teal card with the wordmark, copyright, contact button and
// footer links, then an aqua strip with the legal link.
import Wordmark from '../atoms/Wordmark.astro';
import Text from '../atoms/Text.astro';
import Button from '../atoms/Button.astro';
import Link from '../atoms/Link.astro';
import FooterLink from '../molecules/FooterLink.astro';
import { links } from '../../data/links';
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__card">
			<div class="site-footer__brand">
				<Wordmark as="p" size="m" tone="white" />
				<Text size="s">All rights reserved 2026 ©</Text>
				<Button href={links.connect} variant="primary" size="m" class="site-footer__cta">
					Connect With Us
				</Button>
			</div>
			<nav aria-label="Footer">
				<ul class="site-footer__links" role="list">
					<li><FooterLink href={links.ourStory}>Our Story</FooterLink></li>
					<li><FooterLink href={links.blogfolio}>Blogfolio</FooterLink></li>
					<li><FooterLink href={links.emmaLinkedIn}>Emma’s LinkedIn</FooterLink></li>
					<li><FooterLink href={links.danielaLinkedIn}>Daniela’s LinkedIn</FooterLink></li>
				</ul>
			</nav>
		</div>
	</div>
	<div class="site-footer__legal">
		<div class="container">
			<Link href={links.privacyTerms} variant="arrow" tone="navy">Privacy Policy &amp; Terms of Service</Link>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding-top: var(--space-section);
	}
	.site-footer__card {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-8);
		padding: var(--space-8);
		background: var(--color-surface-band);
		border-radius: var(--radius-l) var(--radius-l) 0 0;
		color: var(--color-text-on-dark);
	}
	.site-footer__brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
	}
	.site-footer :global(.site-footer__cta) {
		margin-top: var(--space-5);
	}
	.site-footer__links {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.site-footer__legal {
		padding-block: var(--space-3);
		background: var(--color-surface-aqua);
		font-size: var(--font-size-small);
		--focus-color: var(--color-focus-on-light);
	}

	@media (max-width: 48rem) {
		.site-footer__card {
			grid-template-columns: 1fr;
			gap: var(--space-6);
			padding: var(--space-card);
		}
	}
</style>
