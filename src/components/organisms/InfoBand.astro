---
// Full-width teal strip with one centred line of text.
import Text from '../atoms/Text.astro';
---

<aside class="info-band">
	<div class="container">
		<Text align="center"><slot /></Text>
	</div>
</aside>

<style>
	.info-band {
		padding-block: var(--space-4);
		background: var(--color-surface-band);
		color: var(--color-text-on-dark);
	}
</style>
