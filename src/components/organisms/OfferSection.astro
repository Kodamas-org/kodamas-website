---
// The offer: the page's one bright (aqua) section. Left, sticky on desktop:
// title, price and booking button. Right: the numbered items, the covered
// topics as tags, and a closing statement on a heavier rule.
// Slot "statement": the closing line (put the conclusion in <strong>).
import Section from '../molecules/Section.astro';
import Heading from '../atoms/Heading.astro';
import Button from '../atoms/Button.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import Tag from '../atoms/Tag.astro';
import Price from '../molecules/Price.astro';
import NumberedItem from '../molecules/NumberedItem.astro';

interface Props {
	id?: string;
	num: string;
	label: string;
	title: string;
	price: { amount: string; duration: string; note?: string };
	cta: { label: string; href: string };
	items: { title: string; text: string }[];
	coveredLabel: string;
	covered: string[];
}

const { id = 'offer', num, label, title, price, cta, items, coveredLabel, covered } = Astro.props;
const titleId = `${id}-title`;
---

<Section id={id} labelledby={titleId} tone="bright" spacing="block" num={num} label={label}>
	<div class="offer">
		<div class="offer__aside">
			<Heading level={2} size="l" id={titleId}>{title}</Heading>
			<Price {...price} />
			<Button href={cta.href} variant="navy">{cta.label}</Button>
		</div>
		<div class="offer__main">
			<ol class="offer__items" role="list">
				{items.map((item, i) => <NumberedItem num={i + 1} title={item.title}>{item.text}</NumberedItem>)}
			</ol>
			<div class="offer__covered" data-reveal>
				<Eyebrow as="h3">{coveredLabel}</Eyebrow>
				<ul class="offer__tags" role="list">
					{covered.map((t) => <Tag>{t}</Tag>)}
				</ul>
			</div>
			<p class="offer__statement" data-reveal><slot name="statement" /></p>
		</div>
	</div>
</Section>

<style>
	.offer {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--layout-col-gap);
		row-gap: var(--space-9);
	}
	.offer__aside {
		grid-column: 1 / span 5;
		align-self: start;
		position: sticky;
		top: var(--layout-sticky-top);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
	}
	.offer__main {
		grid-column: 7 / -1;
		display: flex;
		flex-direction: column;
		gap: var(--space-9);
	}
	.offer__covered {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}
	.offer__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.offer__statement {
		padding-top: var(--space-6);
		border-top: var(--border-width-medium) solid currentColor;
		font-family: var(--font-display);
		font-size: var(--font-size-heading-3);
		font-weight: var(--font-weight-light);
		line-height: var(--line-height-snug);
	}
	.offer__statement :global(strong) {
		font-weight: var(--font-weight-bold);
	}
	@media (max-width: 64rem) {
		.offer__aside,
		.offer__main {
			grid-column: 1 / -1;
		}
		.offer__aside {
			position: static;
		}
	}
</style>
