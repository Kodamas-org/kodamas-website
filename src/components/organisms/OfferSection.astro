---
// The offer: a pink card with eyebrow, title, duration and price, note,
// included items, a closing line and the page's main call to action,
// followed by optional extra cards, on the animated aqua background.
// Slots: default = the items (FeatureCard), "footer" = closing line,
//        "after" = cards shown under the offer card (GlassCard)
import AnimatedBackdrop from '../molecules/AnimatedBackdrop.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import Button from '../atoms/Button.astro';

interface Props {
	eyebrow: string;
	title: string;
	price: string;
	duration: string;
	note: string;
	cta: { label: string; href: string };
}

const { eyebrow, title, price, duration, note, cta } = Astro.props;
---

<AnimatedBackdrop>
	<section class="offer container" aria-labelledby="offer-title">
		<article class="offer__card">
			<header class="offer__header">
				<Eyebrow>{eyebrow}</Eyebrow>
				<Heading level={2} size="l" id="offer-title">{title}</Heading>
				<Text size="l" weight="semibold">{duration} · {price}</Text>
				<Text size="s" italic>{note}</Text>
			</header>
			<div class="offer__items">
				<slot />
			</div>
			<Text align="center" class="offer__closing"><slot name="footer" /></Text>
			<Button href={cta.href} variant="inverse" size="l" class="offer__cta">{cta.label}</Button>
		</article>
		<slot name="after" />
	</section>
</AnimatedBackdrop>

<style>
	.offer {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: calc(var(--layout-narrow-max) + 2 * var(--layout-gutter));
		padding-block: var(--space-section);
	}
	.offer__card {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding: var(--space-card);
		background: var(--color-surface-pink);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-raised);
		color: var(--color-white);
		--focus-color: var(--color-focus-on-light);
	}
	.offer__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.offer__items {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
	}
	.offer :global(.offer__closing) {
		max-width: var(--layout-text-max);
		margin-inline: auto;
	}
	.offer :global(.offer__cta) {
		align-self: center;
	}

	@media (max-width: 48rem) {
		.offer__items {
			grid-template-columns: 1fr;
		}
	}
</style>
