---
// Page template: document head, fonts, tokens, grain, header and footer.
// Each page passes its title and description and fills the main slot.
// It also runs the fade-up reveal for every [data-reveal] element.
import '@fontsource-variable/funnel-display';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
// The two fonts every page shows on load, preloaded so text appears sooner
import funnelDisplayLatin from '@fontsource-variable/funnel-display/files/funnel-display-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/organisms/SiteHeader.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';
import Grain from '../components/atoms/Grain.astro';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href={funnelDisplayLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#1a2231" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Grain />
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	// Fade-up reveal. Content stays visible without JS or with reduced motion.
	const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!calm && 'IntersectionObserver' in window) {
		document.documentElement.classList.add('js-reveal');
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('is-in');
						io.unobserve(e.target);
					}
				}),
			{ rootMargin: '0px 0px -10% 0px' },
		);
		document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
	}
</script>

<style>
	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: calc(var(--z-grain) + 1);
		padding: var(--space-2) var(--space-4);
		background: var(--color-aqua-glow);
		color: var(--color-midnight-navy);
		border-radius: var(--radius-pill);
		transform: translateY(calc(-100% - var(--space-4)));
	}
	.skip-link:focus {
		transform: none;
		--focus-color: var(--color-white);
	}
</style>
