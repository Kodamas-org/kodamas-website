---
// Page template: document head, fonts, tokens, header and footer.
// Each page passes its title and description and fills the main slot.
import '@fontsource-variable/funnel-display';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/organisms/SiteHeader.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: calc(var(--z-header) + 1);
		padding: var(--space-2) var(--space-4);
		background: var(--color-aqua-glow);
		color: var(--color-midnight-navy);
		border-radius: var(--radius-pill);
		transform: translateY(calc(-100% - var(--space-4)));
	}
	.skip-link:focus {
		transform: none;
		--focus-color: var(--color-white);
	}
</style>
